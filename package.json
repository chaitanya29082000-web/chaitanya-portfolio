{
  "name": "chaitanya-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio for Chaitanya Bhambere — open-source contributor and software developer.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:og": "node scripts/make-og.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node scripts/build.mjs && node --test tests/site.test.mjs",
    "check": "node scripts/check.mjs",
    "links": "node scripts/check-links.mjs",
    "lint:html": "html-validate dist/index.html dist/404.html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "html-validate": "^11.21.0",
    "prettier": "^3.10.1"
  }
}
